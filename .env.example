# Kopiraj ovaj fajl u .env.local i popuni vrednosti
# Za generisanje AUTH_SECRET: openssl rand -base64 32
# ili: https://generate-secret.vercel.app/32

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DB_NAME"
AUTH_SECRET="generisi-sa-openssl-rand-base64-32"
NEXTAUTH_URL="https://tvoj-domen.com"

# Prvi dan kvantne slike dana (YYYY-MM-DD). Raniji datumi ostaju izvedeni iz datuma (seedFromDate).
# Bez vrednosti: početak arhive 2026-03-04 — cela arhiva je kvantna (src/lib/daily-art.ts).
# DAILY_QUANTUM_FROM="2026-03-04"

# Studio „Izvuci" ne uzima iz qrng_pool kad je slobodnih redova ovoliko ili manje
# (rezerva za sliku dana); tada koristi kvantno seme + xorshift. Podrazumevano 60.
# STUDIO_POOL_RESERVE="60"
